# ---------------------------------------------------------------------------
# Task-bot configuration. Copy this file to ".env" and fill in the values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# REQUIRED. Token from @BotFather in Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# REQUIRED. Anthropic API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OPTIONAL. Which Claude model to use. Defaults to the most capable model.
# Cheaper alternatives: claude-sonnet-5, claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5

# OPTIONAL but STRONGLY recommended for a personal bot.
# Comma-separated Telegram numeric IDs allowed to use the bot. If empty, the
# bot replies to ANYONE who finds it (and spends your API credits). Send the
# bot /whoami to learn your own ID.
TASKBOT_ALLOWED_CHAT_IDS=

# OPTIONAL. IANA timezone used to interpret "tomorrow 9am", schedule reminders
# and the daily brief. Defaults to UTC. Examples: Europe/Moscow, Europe/Berlin
TASKBOT_TIMEZONE=UTC

# OPTIONAL. Path to the SQLite database file. Defaults to taskbot.db
TASKBOT_DB_PATH=taskbot.db

# OPTIONAL. Time of the daily focus brief in HH:MM (local time). Empty disables
# it. The brief lists what is still pending and what to focus on. Example: 09:00
TASKBOT_DAILY_BRIEF=
